{
  "package": "com.marvis.bandremote",
  "name": "腕控",
  "versionName": "1.0.8",
  "versionCode": 8,
  "minPlatformVersion": 1000,
  "icon": "/common/logo_v2.png",
  "deviceTypeList": ["watch"],
  "features": [
    { "name": "system.router" },
    { "name": "system.interconnect" }
  ],
  "permissions": [
    { "origin": "*" }
  ],
  "router": {
    "entry": "pages/index",
    "pages": {
      "pages/index": { "component": "index", "title": "连接" },
      "pages/remote": { "component": "remote", "title": "遥控" }
    }
  },
  "display": {
    "backgroundColor": "#000000"
  },
  "config": {
    "designWidth": 192
  }
}
