<?xml version="1.0" encoding="utf-8"?>
<!-- 设置页：无障碍引导 / 通道选择 / 功能开关 / 快捷启动应用 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- ============ 权限引导 ============ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/section_permission"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_a11y_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/label_a11y_state"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_open_a11y"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_open_a11y" />

        <TextView
            android:id="@+id/tv_overlay_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/btn_overlay"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_overlay_permission"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_overlay" />

        <!-- ============ 通道选择 ============ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="@string/section_transport"
            android:textSize="16sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rg_transport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rb_mock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/transport_mock" />

            <RadioButton
                android:id="@+id/rb_ble"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/transport_ble" />

            <RadioButton
                android:id="@+id/rb_interconnect"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/transport_interconnect" />
        </RadioGroup>

        <!-- ============ 功能开关 ============ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="@string/section_switch"
            android:textSize="16sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/sw_mouse_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sw_mouse_mode" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/sw_auto_start"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sw_auto_start" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/sw_float_window"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sw_float_window" />

        <!-- ============ 快捷启动应用 ============ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="@string/section_shortcut"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_shortcut_pkg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/not_set"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_pick_app"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_pick_app" />

        <Button
            android:id="@+id/btn_clear_app"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_clear_app" />
    </LinearLayout>
</ScrollView>
